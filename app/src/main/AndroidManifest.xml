<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:enableOnBackInvokedCallback="true"
        android:name=".BunnListApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_season_classic"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.BunnList">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- «أيقونة التطبيق»: one launcher alias per icon; only one is enabled at a time. -->
        <activity-alias
            android:name=".IconClassic"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_season_classic"
            android:roundIcon="@mipmap/ic_season_classic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- «أيقونة التطبيق»: one launcher alias per icon; only one is enabled at a time. -->
        <activity-alias
            android:name=".IconDark"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_season_dark"
            android:roundIcon="@mipmap/ic_season_dark">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- «أيقونة التطبيق»: one launcher alias per icon; only one is enabled at a time. -->
        <activity-alias
            android:name=".IconRamadan"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_season_ramadan"
            android:roundIcon="@mipmap/ic_season_ramadan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- «أيقونة التطبيق»: one launcher alias per icon; only one is enabled at a time. -->
        <activity-alias
            android:name=".IconEidFitr"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_season_eidfitr"
            android:roundIcon="@mipmap/ic_season_eidfitr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- «أيقونة التطبيق»: one launcher alias per icon; only one is enabled at a time. -->
        <activity-alias
            android:name=".IconEidAdha"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_season_eidadha"
            android:roundIcon="@mipmap/ic_season_eidadha">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- «أيقونة التطبيق»: one launcher alias per icon; only one is enabled at a time. -->
        <activity-alias
            android:name=".IconNationalDay"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_season_nationalday"
            android:roundIcon="@mipmap/ic_season_nationalday">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- «أيقونة التطبيق»: one launcher alias per icon; only one is enabled at a time. -->
        <activity-alias
            android:name=".IconFoundingDay"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_season_foundingday"
            android:roundIcon="@mipmap/ic_season_foundingday">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
